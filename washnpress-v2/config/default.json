{
  "app": {
    "env": "development",
    "host": "0.0.0.0",
    "port": 8080,
    "logLevel": "info",
    "corsOrigins": [
      "*"
    ],
    "version": "2.1.0",
    "publicUrl": "http://localhost:8080"
  },
  "storage": {
    "driver": "memory",
    "postgres": {
      "url": "postgresql://washnpress:washnpress@localhost:5432/washnpress",
      "poolMax": 10,
      "connectionTimeoutMs": 5000,
      "idleTimeoutMs": 30000
    }
  },
  "cache": {
    "driver": "memory",
    "redis": {
      "url": "redis://localhost:6379"
    }
  },
  "auth": {
    "otpLength": 6,
    "otpTtlSeconds": 300,
    "otpMaxAttempts": 5,
    "resendCooldownSeconds": 30,
    "lockoutMinutes": 15,
    "sessionTtlSeconds": 604800
  },
  "payments": {
    "provider": "razorpay",
    "currency": "INR",
    "webhookSignatureHeader": "x-razorpay-signature",
    "webhookSecret": "change-me-in-config-local-or-env",
    "keyId": "",
    "keySecret": "",
    "reconcilePollSeconds": 60,
    "baseUrl": "https://api.razorpay.com/v1",
    "methods": {
      "card": false,
      "upi": false,
      "netbanking": false,
      "cash": false
    }
  },
  "scheduling": {
    "slotWindows": [
      "Morning",
      "Afternoon",
      "Evening"
    ],
    "defaultSlotCapacity": 20,
    "bookingCutoffHours": 2,
    "serviceDayOffsetMinutes": 330
  },
  "rateLimit": {
    "otpSend": {
      "limit": 5,
      "windowSeconds": 900
    },
    "api": {
      "limit": 120,
      "windowSeconds": 60
    },
    "apiEnabled": false,
    "otpSendEnabled": true
  },
  "notifications": {
    "sms": {
      "enabled": false,
      "provider": "mock",
      "baseUrl": "",
      "apiKey": "",
      "sender": "",
      "templateId": ""
    },
    "whatsapp": {
      "enabled": false,
      "provider": "mock",
      "baseUrl": "",
      "apiKey": "",
      "sender": "",
      "phoneNumberId": "",
      "templateName": ""
    },
    "push": {
      "enabled": false,
      "provider": "mock",
      "baseUrl": "https://exp.host/--/api/v2/push/send",
      "serverKey": ""
    },
    "email": {
      "enabled": false,
      "provider": "mock",
      "baseUrl": "",
      "apiKey": "",
      "fromAddress": "",
      "fromName": ""
    }
  },
  "support": {
    "email": "",
    "phone": "",
    "whatsapp": "",
    "hours": ""
  },
  "jobs": {
    "enabled": true,
    "outboxIntervalSeconds": 5,
    "reconciliationIntervalSeconds": 60,
    "recurringGenerationIntervalSeconds": 3600,
    "recurringHorizonDays": 7
  },
  "observability": {
    "metricsEnabled": true,
    "tracingEnabled": false,
    "otlpEndpoint": "",
    "docsEnabled": true
  }
}
