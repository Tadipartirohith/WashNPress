# Any config value can be overridden with an environment variable using the
# WNP_ prefix and a double underscore for each level of nesting.
# Environment variables always win over config/local.json and config/default.json.

# WNP_APP__PORT=8080
# WNP_STORAGE__DRIVER=postgres
# WNP_STORAGE__POSTGRES__URL=postgresql://washnpress:washnpress@postgres:5432/washnpress
# WNP_CACHE__DRIVER=redis
# WNP_CACHE__REDIS__URL=redis://redis:6379
# WNP_PAYMENTS__WEBHOOKSECRET=your-razorpay-webhook-secret

# Convenience aliases (also supported):
# PORT=8080
# DATABASE_URL=postgresql://washnpress:washnpress@postgres:5432/washnpress
# REDIS_URL=redis://redis:6379
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
