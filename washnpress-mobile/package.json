{
  "name": "washnpress-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "resident": "APP_VARIANT=resident expo start",
    "staff": "APP_VARIANT=staff expo start",
    "resident:android": "APP_VARIANT=resident expo start --android",
    "resident:ios": "APP_VARIANT=resident expo start --ios",
    "resident:web": "APP_VARIANT=resident expo start --web",
    "staff:android": "APP_VARIANT=staff expo start --android",
    "staff:ios": "APP_VARIANT=staff expo start --ios",
    "staff:web": "APP_VARIANT=staff expo start --web",
    "icons": "python3 scripts/make_icons.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.0",
    "expo-camera": "~15.0.16",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-notifications": "~0.28.19",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-web": "~0.19.10"
  },
  "devDependencies": {
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3",
    "vitest": "^2.1.8"
  }
}
