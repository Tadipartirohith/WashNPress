{
  "name": "washnpress-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "resident": "cross-env APP_VARIANT=resident expo start",
    "staff": "cross-env APP_VARIANT=staff expo start",
    "resident:android": "cross-env APP_VARIANT=resident expo start --android",
    "resident:ios": "cross-env APP_VARIANT=resident expo start --ios",
    "resident:web": "cross-env APP_VARIANT=resident expo start --web",
    "staff:android": "cross-env APP_VARIANT=staff expo start --android",
    "staff:ios": "cross-env APP_VARIANT=staff expo start --ios",
    "staff:web": "cross-env APP_VARIANT=staff expo start --web",
    "icons": "python3 scripts/make_icons.py",
    "typecheck": "tsc --noEmit",
    "verify:contrast": "node scripts/verify-contrast.mjs && node scripts/verify-contrast.mjs --dark",
    "verify:env": "node scripts/verify-env-inlining.mjs",
    "verify": "npm run typecheck && npm run verify:contrast && npm run verify:env && npm run verify:modal && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:modal": "node scripts/verify-modal-dismiss.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.21",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.37.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.4",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
